# Local PostgreSQL connection used by the app.
# This database is created by `npm run db:create`.
DATABASE_URL=postgresql://prom2@localhost:5432/empower_humanity

# Connection to the default `postgres` database, used only by
# `npm run db:create` to issue `CREATE DATABASE` (cannot run inside
# the target database itself).
ADMIN_DATABASE_URL=postgresql://prom2@localhost:5432/postgres

# Secret used to sign the admin session cookie. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# Credentials for the seeded admin account (used by `npm run db:seed`).
SEED_ADMIN_EMAIL=admin@empower-humanity.org
SEED_ADMIN_PASSWORD=empower-humanity-dev

# Public origin of the site, used for share cards (Open Graph), the sitemap
# and links in staff emails. Optional on Vercel, which provides its
# production domain automatically; set it once a custom domain is live.
# NEXT_PUBLIC_SITE_URL=https://www.example.org

# Staff email alerts for new volunteers, messages and transfer notices,
# sent with Resend (https://resend.com). All three are needed; leave them
# unset to turn alerts off — submissions still land in the admin.
# The sender must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_FROM="Empower Humanity <notifications@example.org>"
# NOTIFY_EMAIL_TO=team@example.org,director@example.org
