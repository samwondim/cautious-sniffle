# Local PostgreSQL connection used by the app.
# This database is created by `npm run db:create`.
DATABASE_URL=postgresql://prom2@localhost:5432/empower_humanity

# Connection to the default `postgres` database, used only by
# `npm run db:create` to issue `CREATE DATABASE` (cannot run inside
# the target database itself).
ADMIN_DATABASE_URL=postgresql://prom2@localhost:5432/postgres

# Secret used to sign the admin session cookie. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# Credentials for the seeded admin account (used by `npm run db:seed`).
SEED_ADMIN_EMAIL=admin@empower-humanity.org
SEED_ADMIN_PASSWORD=empower-humanity-dev
